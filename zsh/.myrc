# rc file for Matt the Person

source <(fzf --zsh)

# --------------------------------
# GENERAL
# --------------------------------

bindkey -s '^H' '~/'
# xset r rate 150 40 # x11 (no Wayland)

# --------------------------------
# ALIASES
# --------------------------------

alias nvim-lazy="NVIM_APPNAME=nvim-lazyvim nvim"
alias lvim="nvim-lazy"
alias nvim-kick="NVIM_APPNAME=nvim-kickstart nvim"
alias kvim="nvim-kick"
alias nvim-nvchad="NVIM_APPNAME=nvim-nvchad nvim"
alias nvchad="nvim-nvchad"

alias lx="ls -lXh"

alias fd="fdfind"
alias ff="fzf"
alias fff="fdfind . --type f | fzf"
alias ffd="fdfind . --type d | fzf"
alias fe="setsid dolphin . >/dev/null 2>&1 &" # open dolphin and forget about process
alias co="codium"
alias qu="exit"

alias bat="batcat" # batcat is bat
alias batjson="bat -l json"
alias less="bat"

# - GIT -
alias gits="git status"
alias gita="git add"
alias gitd="git diff"
alias gitr="git restore --staged"
alias gitl="git log --oneline"
alias gitc="git commit -m"
alias gitsync="git add . && git commit -m 'git sync' && git pull --rebase && git push"

# --------------------------------
# ENVIRONMENT VARIABLES
# --------------------------------

export MANPAGER="batcat -plman" # man with syntax highlighting

export CONF_MY="$HOME/.myrc"
export CONF_ZSH="$HOME/.zshrc"
export CONF_BASH="$HOME/.bashrc"
export CONF_ZSHTHEME="$ZSH/custom/themes/$ZSH_THEME.zsh-theme"
export CONF_NVIM="$HOME/.config/nvim/init.lua"
export CONF_TMUX="$HOME/.tmux.conf"

export WINHOME="/mnt/c/Users/stirl/" # Windows home (WSL)

#export CHEAT_VIM="$HOME/cheatsheets/vim.md"
#export CHEAT_TMUX="$HOME/cheatsheets/tmux.md"

# --------------------------------
# SHELL FUNCTIONS
# --------------------------------

# yazi: escape to folder
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}

# cd into dir and list contents
cdl() {
    cd "$1" && ls -lah
}

# Function for cd-ing into the directory of a utility
cmdcd() {
    if [[ -z "$1" ]]; then
        echo "Usage: cmdcd UTILITY"
        return 1
    fi

    # Get the full path of the utility
    local CMD_PATH
    CMD_PATH=$(which "$1" 2>/dev/null)

    if [[ -z "$CMD_PATH" ]]; then
        echo "Command '$1' not found."
        return 1
    fi

    # Resolve symbolic links to the actual file
    local REAL_PATH
    REAL_PATH=$(readlink -f "$CMD_PATH")

    # Extract the directory and change to it
    local CMD_DIR
    CMD_DIR=$(dirname "$REAL_PATH")

    cd "$CMD_DIR" || {
        echo "Failed to cd into $CMD_DIR."
        return 1
    }

    echo "Changed directory to $CMD_DIR"
}

# open cheatsheets
cheat() {
    local dir="$HOME/cheatsheets"
    local file="$dir/$1.md"
    local viewer=(less)

    if [ ! -d "$dir" ]; then
        echo "Directory $dir does not exist." >&2
        return 1
    fi

    if [ ! -f "$file" ]; then
        [ -n "$1" ] && echo "No cheatsheet found for '$1'." >&2
        echo "Available cheatsheets:"
        ls -1 "$dir" | sed 's/\.md$//'
        return 1
    fi

    if command -v batcat >/dev/null 2>&1; then
        viewer=(batcat --language=markdown)
    elif command -v bat >/dev/null 2>&1; then
        viewer=(bat --language=markdown)
    else
        echo "Warning: bat is not installed; falling back to less." >&2
    fi

    "${viewer[@]}" "$file"
}

# ---------------------
# YOING & YEET
# ---------------------

export YOINKED_CLIPBOARD="/tmp/yoinked_clipboard"

yoink() {
    
    # read "$1"
    local src="$1"

    # check if $1 exists
    if [[ -z "$src" || ! -e "$src" ]]; then
        echo "Source does not exist."
        return 1
    fi

    # write to file
    echo "$(realpath "$src")" > "$YOINKED_CLIPBOARD"
    echo "Added item to yeet: $src"
}

yeet() {

    # check if file exists
    if [[ ! -f "$YOINKED_CLIPBOARD" ]]; then
        echo "Nothing to yeet!"
        return 1
    fi

    # read from file and check if src exists
    local src
    src=$(<"$YOINKED_CLIPBOARD")
    if [[ ! -e "$src" ]]; then
        echo "Yeetable item doesn't exist: $src"
        rm -f "$YOINKED_CLIPBOARD"
        return 1
    fi

    # yeet check
    if [[ "$1" == "check" ]]; then
        echo "$src"
        return 0
    fi

    # yeet copy
    if [[ "$1" == "copy" ]]; then
        if ! cp -r "$src" .; then
	        echo "Failed to copy $src"
	        return 1
	    fi
	    echo "Copied: $(basename "$src")"
	    return 0
    fi

    # yeet UNKNOWN
    if [[ -n "$1" ]]; then
        echo "Unknown yeet command $1. Use 'check' or 'copy'"
        return 1
    fi

    # attempt mv src dst
    if ! mv "$src" .; then
        echo "Failed to move $src"
        return 1
    fi
    echo "Yeeted: $(basename "$src")"
    rm -f "$YOINKED_CLIPBOARD"
}

